# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Comma-separated Discord user IDs allowed to use the Oxy developer panel.
# Example: BOT_OWNER_IDS=123456789012345678,987654321098765432
BOT_OWNER_IDS=

# Oxford Response
OXFORD_API_BASE=https://api.oxfd.re/v1
# Optional legacy fallback. Prefer per-guild keys through /config or the dashboard.
OXFORD_API_KEY=
OXFORD_ADMIN_ROLE_ID=

# API
API_HOST=127.0.0.1
API_PORT=4000
API_TRUST_PROXY=true
API_CORS_ORIGINS=https://dashboard.oxcontroller.app
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
API_COMMAND_RATE_LIMIT_WINDOW_MS=60000
API_COMMAND_RATE_LIMIT_MAX=5

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to encrypt Oxford Response server keys at rest.
# Keep this value permanently once encrypted keys have been stored.
ENCRYPTION_KEY=

# Sharding
SHARD_GUILDS_PER_SHARD=10
SHARD_SCALE_INTERVAL_MS=60000

# Roblox
ROBLOX_API_TIMEOUT_MS=10000
ROBLOX_LINK_PREFIX=OXCTRL-

# Shifts
SHIFT_CHECK_INTERVAL_MS=180000
SHIFT_MIN_MOVEMENT=5
SHIFT_REQUIRE_MOVEMENT=true

# Lavalink
# Docker Compose starts this service automatically. The bot talks to it over the private Compose network.
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=oxy-lavalink-local
LAVALINK_SECURE=false

# Music
# Audio is handled by the Lavalink service defined in docker-compose.yml.
MUSIC_ENABLED=true
MUSIC_DJ_ROLE_ID=
MUSIC_LEAVE_ON_EMPTY=true
MUSIC_DEFAULT_VOLUME=75
MUSIC_MAX_QUEUE=100

# AutoMod
AUTOMOD_ENABLED=true
AUTOMOD_DELETE_MESSAGES=true
AUTOMOD_LOGGING=true

# Dashboard
# Enables the web dashboard.
# Discord OAuth2 must be configured in the Developer Portal.
DASHBOARD_ENABLED=true
# Discord OAuth2 application client ID. Defaults to DISCORD_CLIENT_ID if blank.
DASHBOARD_CLIENT_ID=
# Discord OAuth2 client secret. Keep server-side and never expose it in frontend code.
DASHBOARD_CLIENT_SECRET=
# Must exactly match the redirect URI configured in the Discord Developer Portal.
DASHBOARD_REDIRECT_URI=https://dashboard.oxcontroller.app/auth/callback
# Session lifetime in milliseconds.
DASHBOARD_SESSION_TTL_MS=86400000

# AI Server Templates
# Only these Discord user IDs can create server templates through the developer panel using xAI.
TEMPLATE_CREATOR_IDS=1353829659082752122,1477380573235515425
# xAI API key. Keep server-side; never expose it to Discord users or the future website.
XAI_API_KEY=
# Current xAI model used for template generation.
XAI_TEMPLATE_MODEL=grok-4.7
# Editable AI instructions used when generating Oxy server templates.
TEMPLATE_INSTRUCTIONS_PATH=./config/templates/instructions.txt
# Optional code contributor benefit duration, in days.
CONTRIBUTOR_CODE_DAYS=30

# Website API
# API used by the future Oxy Controller website. Keep the key server-side.
WEBSITE_API_ENABLED=true
WEBSITE_API_KEY=
WEBSITE_API_CORS_ORIGINS=https://oxcontroller.app,https://www.oxcontroller.app
WEBSITE_API_RATE_LIMIT_WINDOW_MS=60000
WEBSITE_API_RATE_LIMIT_MAX=120

# AutoMod bypass: guild owners and members with Administrator permission bypass all Oxy AutoMod checks
AUTOMOD_BYPASS_ADMINS=true

# Public branding / URLs (used by bot settings, website integration and dashboard UI)
# Set these once and avoid hardcoding production URLs in bot/dashboard code.
WEBSITE_URL=https://oxcontroller.app
DASHBOARD_URL=https://dashboard.oxcontroller.app
PUBLIC_API_URL=https://api.oxcontroller.app

# Rotating status messages. Separate messages with | characters.
WEBSITE_STATUS_MESSAGES=Coming soon...|Ohh... Exciting!|We're getting things ready...|Something big is coming...
DASHBOARD_STATUS_MESSAGES=Coming soon...|Ohh... Exciting!|Your dashboard is getting an upgrade...|More control is on the way...
WEBSITE_MESSAGE_ROTATION_MS=5000
DASHBOARD_MESSAGE_ROTATION_MS=5000

# Channel used for community server template review notifications
TEMPLATE_REVIEW_CHANNEL_ID=
